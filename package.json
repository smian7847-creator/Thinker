{
  "name": "smallweb",
  "private": true,
  "workspaces": ["shared", "api", "web"],
  "devDependencies": {
    "mongodb-memory-server": "10.2.0"
  },
  "scripts": {
    "postinstall": "npm run build -w shared",
    "db": "node scripts/db.mjs",
    "seed": "npm run seed -w api --",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "test": "npm test -w shared && npm test -w api"
  }
}
